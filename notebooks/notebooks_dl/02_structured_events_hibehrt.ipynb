   "source": [
    "## HiBEHRT Sequence Construction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def build_hibehrt_sequences(events_df: pd.DataFrame, cohort_df: pd.DataFrame, vocab: dict, config: dict) -> Dict:\n",
    "    \"\"\"Build hierarchical sequences for HiBEHRT model.\"\"\"\n",
    "    \n",
    "    print(\"=== HIBEHRT SEQUENCE CONSTRUCTION ===\")\n",
    "    \n",
    "    # Initialize hierarchical structure\n",
    "    patient_sequences = {}\n",
    "    max_events_per_adm = config['model']['max_events_per_adm']\n",
    "    \n",
    "    # Group by patient\n",
    "    patient_groups = events_df.groupby('subject_id')\n",
    "    \n",
    "    for patient_id, patient_events in patient_groups:\n",
    "        if len(patient_sequences) % 100 == 0:\n",
    "            print(f\"  Processing patient {len(patient_sequences):,}\")\n",
    "        \n",
    "        # Group by admission for this patient\n",
    "        admission_groups = patient_events.groupby('hadm_id')\n",
    "        \n",
    "        patient_data = {\n",
    "            'subject_id': patient_id,\n",
    "            'admissions': [],\n",
    "            'num_admissions': len(admission_groups)\n",
    "        }\n",
    "        \n",
    "        for hadm_id, admission_events in admission_groups:\n",
    "            \n",
    "            # Sort events by time within admission\n",
    "            admission_events = admission_events.sort_values('hours_from_admit')\n",
    "            \n",
    "            # Convert tokens to IDs\n",
    "            token_ids = []\n",
    "            time_deltas = []\n",
    "            values = []\n",
    "            \n",
    "            for _, event in admission_events.iterrows():\n",
    "                token = event['event_token']\n",
    "                token_id = vocab['token_to_id'].get(token, vocab['special_tokens']['UNK'])\n",
    "                \n",
    "                token_ids.append(token_id)\n",
    "                time_deltas.append(event['hours_from_admit'])\n",
    "                values.append(event.get('numeric_value', 0.0))\n",
    "            \n",
    "            # Truncate if too many events\n",
    "            if len(token_ids) \u003e max_events_per_adm:\n",
    "                token_ids = token_ids[:max_events_per_adm]\n",
    "                time_deltas = time_deltas[:max_events_per_adm]\n",
    "                values = values[:max_events_per_adm]\n",
    "            \n",
    "            admission_data = {\n",
    "                'hadm_id': hadm_id,\n",
    "                'admittime': event['admittime'],  # From merge\n",
    "                'token_ids': token_ids,\n",
    "                'time_deltas': time_deltas,\n",
    "                'values': values,\n",
    "                'num_events': len(token_ids),\n",
    "                'event_types': admission_events['event_type'].tolist()\n",
    "            }\n",
    "            \n",
    "            patient_data['admissions'].append(admission_data)\n",
    "        \n",
    "        patient_sequences[patient_id] = patient_data\n",
    "    \n",
    "    print(f\"Built sequences for {len(patient_sequences):,} patients\")\n",
    "    \n",
    "    # Calculate statistics\n",
    "    total_admissions = sum(len(p['admissions']) for p in patient_sequences.values())\n",
    "    total_events = sum(sum(len(adm['token_ids']) for adm in p['admissions']) \n",
    "                      for p in patient_sequences.values())\n",
    "    \n",
    "    print(f\"Total admissions: {total_admissions:,}\")\n",
    "    print(f\"Total events: {total_events:,}\")\n",
    "    print(f\"Average events per admission: {total_events/total_admissions:.1f}\")\n",
    "    \n",
    "    return {\n",
    "        'patient_sequences': patient_sequences,\n",
    "        'statistics': {\n",
    "            'num_patients': len(patient_sequences),\n",
    "            'num_admissions': total_admissions,\n",
    "            'num_events': total_events,\n",
    "            'avg_events_per_admission': total_events / total_admissions if total_admissions \u003e 0 else 0\n",
    "        }\n",
    "    }\n",
    "\n",
    "# Build sequences\n",
    "if len(events_with_bins) \u003e 0:\n",
    "    hibehrt_data = build_hibehrt_sequences(events_with_bins, cohort_df, vocab, HIBEHRT_CONFIG)\n",
    "else:\n",
    "    print(\"⚠ Skipping sequence construction - no processed events\")\n",
    "    hibehrt_data = {'patient_sequences': {}, 'statistics': {}}"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Save HiBEHRT Data and Visualizations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def save_hibehrt_data(hibehrt_data: Dict, vocab: Dict, config: dict) -> None:\n",
    "    \"\"\"Save HiBEHRT processed data and vocabulary.\"\"\"\n",
    "    \n",
    "    print(\"=== SAVING HIBEHRT DATA ===\")\n",
    "    \n",
    "    out_dir = OUTPUT_DIR\n",
    "    \n",
    "    # Save structured events\n",
    "    events_file = out_dir / config['output']['structured_events']\n",
    "    \n",
    "    # Convert to DataFrame for easier storage\n",
    "    sequences_list = []\n",
    "    for patient_id, patient_data in hibehrt_data['patient_sequences'].items():\n",
    "        for admission in patient_data['admissions']:\n",
",
    "            sequences_list.append({\n",
    "                'subject_id': patient_id,\n",
    "                'hadm_id': admission['hadm_id'],\n",
    "                'token_ids': admission['token_ids'],\n",
    "                'time_deltas': admission['time_deltas'],\n",
    "                'values': admission['values'],\n",
    "                'num_events': admission['num_events'],\n",
    "                'admittime': admission['admittime']\n",
    "            })\n",
    "    \n",
    "    if sequences_list:\n",
    "        sequences_df = pd.DataFrame(sequences_list)\n",
    "        sequences_df.to_parquet(events_file)\n",
    "        print(f\"Saved structured events: {events_file}\")\n",
    "        print(f\"  Shape: {sequences_df.shape}\")\n",
    "    \n",
    "    # Save vocabulary\n",
    "    vocab_file = out_dir / config['output']['event_vocabulary']\n",
    "    with open(vocab_file, 'w') as f:\n",
    "        json.dump(vocab, f, indent=2)\n",
    "    print(f\"Saved vocabulary: {vocab_file}\")\n",
    "    \n",
    "    # Save statistics\n",
    "    stats_file = out_dir / config['output']['temporal_stats']\n",
    "    with open(stats_file, 'w') as f:\n",
    "        json.dump(hibehrt_data['statistics'], f, indent=2)\n",
    "    print(f\"Saved statistics: {stats_file}\")\n",
    "\n",
    "# Save data\n",
    "save_hibehrt_data(hibehrt_data, vocab, HIBEHRT_CONFIG)"
   ]
