    "## Load MIMIC-IV Event Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_mimic_events(data_dir: Path, cohort_hadm_ids: set) -> Dict[str, pd.DataFrame]:\n",
    "    \"\"\"Load timestamped clinical events for cohort admissions.\"\"\"\n",
    "    \n",
    "    print(\"=== LOADING MIMIC-IV EVENT DATA ===\")\n",
    "    events = {}\n",
    "    \n",
    "    # Load lab events\n",
    "    print(\"Loading lab events...\")\n",
    "    lab_path = data_dir / 'hosp' / 'labevents.csv.gz'\n",
    "    if lab_path.exists():\n",
    "        labs = pd.read_csv(lab_path, parse_dates=['charttime'])\n",
    "        labs = labs[labs['hadm_id'].isin(cohort_hadm_ids)]\n",
    "        events['labs'] = labs\n",
    "        print(f\"  Loaded {len(labs):,} lab events for {labs['hadm_id'].nunique():,} admissions\")\n",
    "    \n",
    "    # Load procedures (ICD)\n",
    "    print(\"Loading procedures...\")\n",
    "    proc_path = data_dir / 'hosp' / 'procedures_icd.csv.gz'\n",
    "    if proc_path.exists():\n",
    "        procedures = pd.read_csv(proc_path)\n",
    "        procedures = procedures[procedures['hadm_id'].isin(cohort_hadm_ids)]\n",
    "        events['procedures'] = procedures\n",
    "        print(f\"  Loaded {len(procedures):,} procedures for {procedures['hadm_id'].nunique():,} admissions\")\n",
    "    \n",
    "    # Load diagnoses (ICD)\n",
    "    print(\"Loading diagnoses...\")\n",
    "    diag_path = data_dir / 'hosp' / 'diagnoses_icd.csv.gz'\n",
    "    if diag_path.exists():\n",
    "        diagnoses = pd.read_csv(diag_path)\n",
    "        diagnoses = diagnoses[diagnoses['hadm_id'].isin(cohort_hadm_ids)]\n",
    "        events['diagnoses'] = diagnoses\n",
    "        print(f\"  Loaded {len(diagnoses):,} diagnoses for {diagnoses['hadm_id'].nunique():,} admissions\")\n",
    "    \n",
    "    # Load prescriptions (medications)\n",
    "    print(\"Loading medications...\")\n",
    "    med_path = data_dir / 'hosp' / 'prescriptions.csv.gz'\n",
    "    if med_path.exists():\n",
    "        meds = pd.read_csv(med_path, parse_dates=['starttime', 'stoptime'])\n",
    "        meds = meds[meds['hadm_id'].isin(cohort_hadm_ids)]\n",
    "        events['medications'] = meds\n",
    "        print(f\"  Loaded {len(meds):,} medication orders for {meds['hadm_id'].nunique():,} admissions\")\n",
    "    \n",
    "    # Load ICU chartevents for vitals\n",
    "    print(\"Loading vital signs...\")\n",
    "    vitals_path = data_dir / 'icu' / 'chartevents.csv.gz'\n",
    "    if vitals_path.exists():\n",
    "        # Sample vitals for efficiency (can be very large)\n",
    "        # In production, use more targeted loading\n",
    "        vitals = pd.read_csv(vitals_path, parse_dates=['charttime'])\n",
    "        vitals = vitals[vitals['hadm_id'].isin(cohort_hadm_ids)]\n",
    "        \n",
    "        # Filter to common vital signs\n",
    "        vital_items = [220045, 220210, 220052, 220277, 220050]  # Heart rate, resp rate, etc.\n",
    "        vitals = vitals[vitals['itemid'].isin(vital_items)]\n",
    "        events['vitals'] = vitals\n",
    "        print(f\"  Loaded {len(vitals):,} vital sign measurements for {vitals['hadm_id'].nunique():,} admissions\")\n",
    "    \n",
    "    return events\n",
    "\n",
    "# Get cohort HADM IDs\n",
    "if cohort_df is not None:\n",
    "    cohort_hadm_ids = set(cohort_df['hadm_id'])\n",
    "    print(f\"Processing events for {len(cohort_hadm_ids):,} cohort admissions\")\n",
    "    \n",
    "    # Load events\n",
    "    events_data = load_mimic_events(DATA_DIR, cohort_hadm_ids)\n",
    "else:\n",
    "    print(\"⚠ No cohort data available. Loading sample events for demonstration.\")\n",
    "    events_data = load_mimic_events(DATA_DIR, set())  # Empty set for demo"
   ]
  },
