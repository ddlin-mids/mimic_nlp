    "## Event Preprocessing and Normalization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def preprocess_events(events_data: Dict[str, pd.DataFrame], cohort_df: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"Preprocess events for HiBEHRT tokenization.\"\"\"\n",
    "    \n",
    "    print(\"=== EVENT PREPROCESSING ===\")\n",
    "    \n",
    "    processed_events = []\n",
    "    \n",
    "    # Process lab events\n",
    "    if 'labs' in events_data:\n",
    "        labs = events_data['labs'].copy()\n",
    "        labs['event_type'] = 'lab'\n",
    "        labs['event_code'] = 'LAB:' + labs['itemid'].astype(str)\n",
    "        labs['event_time'] = labs['charttime']\n",
    "        labs['value'] = labs['valuenum']\n",
    "        labs['unit'] = labs['valueuom']\n",
    "        \n",
    "        # Filter to valid values\n",
    "        labs = labs[labs['value'].notna() \u0026 labs['event_time'].notna()]\n",
    "        processed_events.append(labs[['subject_id', 'hadm_id', 'event_type', 'event_code', \n",
    "                                     'event_time', 'value', 'unit']])\n",
    "        print(f\"  Processed {len(labs):,} lab events\")\n",
    "    \n",
    "    # Process vital signs\n",
    "    if 'vitals' in events_data:\n",
    "        vitals = events_data['vitals'].copy()\n",
    "        vitals['event_type'] = 'vital'\n",
    "        vitals['event_code'] = 'VITAL:' + vitals['itemid'].astype(str)\n",
    "        vitals['event_time'] = vitals['charttime']\n",
    "        vitals['value'] = vitals['value']\n",
    "        vitals['unit'] = vitals['valueuom']\n",
    "        \n",
    "        # Filter to valid values\n",
    "        vitals = vitals[vitals['value'].notna() \u0026 vitals['event_time'].notna()]\n",
    "        processed_events.append(vitals[['subject_id', 'hadm_id', 'event_type', 'event_code', \n",
    "                                      'event_time', 'value', 'unit']])\n",
    "        print(f\"  Processed {len(vitals):,} vital events\")\n",
    "    \n",
    "    # Process procedures\n",
    "    if 'procedures' in events_data:\n",
    "        procedures = events_data['procedures'].copy()\n",
    "        procedures['event_type'] = 'procedure'\n",
    "        procedures['event_code'] = 'PROC:' + procedures['icd_code']\n",
    "        procedures['event_time'] = procedures['hadm_id'].map(\n",
    "            cohort_df.set_index('hadm_id')['admittime'].to_dict()\n",
    "        )  # Use admission time as procedure time\n",
    "        procedures['value'] = 1.0  # Binary indicator\n",
    "        procedures['unit'] = 'binary'\n",
    "        \n",
    "        processed_events.append(procedures[['subject_id', 'hadm_id', 'event_type', 'event_code', \n",
    "                                          'event_time', 'value', 'unit']])\n",
    "        print(f\"  Processed {len(procedures):,} procedure events\")\n",
    "    \n",
    "    # Process diagnoses\n",
    "    if 'diagnoses' in events_data:\n",
    "        diagnoses = events_data['diagnoses'].copy()\n",
    "        diagnoses['event_type'] = 'diagnosis'\n",
    "        diagnoses['event_code'] = 'DIAG:' + diagnoses['icd_code']\n",
    "        diagnoses['event_time'] = diagnoses['hadm_id'].map(\n",
    "            cohort_df.set_index('hadm_id')['admittime'].to_dict()\n",
    "        )  # Use admission time as diagnosis time\n",
    "        diagnoses['value'] = 1.0  # Binary indicator\n",
    "        diagnoses['unit'] = 'binary'\n",
    "        \n",
    "        processed_events.append(diagnoses[['subject_id', 'hadm_id', 'event_type', 'event_code', \n",
    "                                         'event_time', 'value', 'unit']])\n",
    "        print(f\"  Processed {len(diagnoses):,} diagnosis events\")\n",
    "    \n",
    "    # Process medications\n",
    "    if 'medications' in events_data:\n",
    "        meds = events_data['medications'].copy()\n",
    "        meds['event_type'] = 'medication'\n",
    "        meds['event_code'] = 'MED:' + meds['gsn'].astype(str).fillna('UNKNOWN')\n",
    "        meds['event_time'] = meds['starttime']\n",
    "        meds['value'] = meds['dose_val_rx'].astype(str)  # Keep as string for now\n",
    "        meds['unit'] = meds['dose_unit_rx']\n",
    "        \n",
    "        # Filter to valid start times\n",
    "        meds = meds[meds['event_time'].notna()]\n",
    "        processed_events.append(meds[['subject_id', 'hadm_id', 'event_type', 'event_code', \n",
    "                                    'event_time', 'value', 'unit']])\n",
    "        print(f\"  Processed {len(meds):,} medication events\")\n",
    "    \n",
    "    # Combine all events\n",
    "    if processed_events:\n",
    "        all_events = pd.concat(processed_events, ignore_index=True)\n",
    "        print(f\"\\nTotal processed events: {len(all_events):,}\")\n",
    "        return all_events\n",
    "    else:\n",
    "        print(\"⚠ No events to process\")\n",
    "        return pd.DataFrame()\n",
    "\n",
    "# Process events\n",
    "if cohort_df is not None:\n",
    "    processed_events = preprocess_events(events_data, cohort_df)\n",
    "else:\n",
    "    print(\"⚠ Processing sample events for demonstration\")\n",
    "    processed_events = preprocess_events(events_data, pd.DataFrame())"
   ]
  },
