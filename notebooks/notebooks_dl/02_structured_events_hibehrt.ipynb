   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Temporal Encoding and Admission Alignment"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def align_events_to_admissions(events_df: pd.DataFrame, cohort_df: pd.DataFrame, config: dict) -> pd.DataFrame:\n",
    "    \"\"\"Align events to admission timeline for HiBEHRT processing.\"\"\"\n",
    "    \n",
    "    print(\"=== TEMPORAL ALIGNMENT ===\")\n",
    "    \n",
    "    # Merge with cohort to get admission times\n",
    "    events_aligned = events_df.merge(\n",
    "        cohort_df[['hadm_id', 'subject_id', 'admittime', 'dischtime']], \n",
    "        on=['hadm_id', 'subject_id'], \n",
    "        how='inner'\n",
    "    )\n",
    "    \n",
    "    # Calculate relative time from admission start\n",
    "    events_aligned['hours_from_admit'] = (\n",
    "        events_aligned['event_time'] - events_aligned['admittime']\n",
    "    ).dt.total_seconds() / 3600\n",
    "    \n",
    "    # Filter events to admission window (pre-discharge only to avoid leakage)\n",
    "    events_aligned = events_aligned[\n",
    "        (events_aligned['hours_from_admit'] \u003e= 0) \u0026\n",
    "        (events_aligned['event_time'] \u003c= events_aligned['dischtime'])\n",
    "    ]\n",
    "    \n",
    "    # Apply temporal bucketing\n",
    "    bucket_size = config['events']['time_bucket_size']\n",
    "    if bucket_size.endswith('H'):\n",
    "        bucket_hours = int(bucket_size[:-1])\n",
    "        events_aligned['time_bucket'] = (events_aligned['hours_from_admit'] // bucket_hours).astype(int)\n",
    "    \n",
    "    # Create event tokens\n",
    "    events_aligned['event_token'] = (\n",
    "        events_aligned['event_type'] + ':' + \n",
    "        events_aligned['event_code'] + ':' + \n",
    "        events_aligned['time_bucket'].astype(str)\n",
    "    )\n",
    "    \n",
    "    print(f\"Aligned {len(events_aligned):,} events to admission timeline\")\n",
    "    print(f\"Event time range: {events_aligned['hours_from_admit'].min():.1f} to {events_aligned['hours_from_admit'].max():.1f} hours\")\n",
    "    \n",
    "    # Event statistics by admission\n",
    "    admission_stats = events_aligned.groupby('hadm_id').agg({\n",
    "        'event_token': 'count',\n",
    "        'hours_from_admit': ['min', 'max'],\n",
    "        'event_type': 'nunique'\n",
    "    }).round(2)\n",
    "    \n",
    "    admission_stats.columns = ['num_events', 'first_event_hrs', 'last_event_hrs', 'event_types']\n",
    "    \n",
    "    print(f\"\\nAdmission event statistics:\")\n",
    "    print(f\"  Mean events per admission: {admission_stats['num_events'].mean():.1f}\")\n",
    "    print(f\"  Median events per admission: {admission_stats['num_events'].median():.1f}\")\n",
    "    print(f\"  Admissions with \u003e100 events: {(admission_stats['num_events'] \u003e 100).sum():,}\")\n",
    "    \n",
    "    return events_aligned, admission_stats\n",
    "\n",
    "# Align events if we have data\n",
    "if len(processed_events) \u003e 0 and cohort_df is not None:\n",
    "    aligned_events, admission_stats = align_events_to_admissions(processed_events, cohort_df, HIBEHRT_CONFIG)\n",
    "else:\n",
    "    print(\"⚠ Skipping alignment - no events or cohort data\")\n",
    "    aligned_events = pd.DataFrame()\n",
    "    admission_stats = pd.DataFrame()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Value Discretization and Token Creation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_event_vocabulary(aligned_events: pd.DataFrame, config: dict) -> Dict:\n",
    "    \"\"\"Create vocabulary for event tokens following HiBEHRT approach.\"\"\"\n",
    "    \n",
    "    print(\"=== EVENT VOCABULARY CREATION ===\")\n",
    "    \n",
    "    # Count event token frequencies\n",
    "    token_counts = aligned_events['event_token'].value_counts()\n",
    "    min_freq = config['events']['min_frequency']\n",
    "    \n",
    "    # Filter by minimum frequency\n",
    "    frequent_tokens = token_counts[token_counts \u003e= min_freq]\n",
    "    \n",
    "    # Create vocabulary mapping\n",
    "    vocab = {\n",
    "        'token_to_id': {},\n",
    "        'id_to_token': {},\n",
    "        'token_frequencies': frequent_tokens.to_dict(),\n",
    "        'special_tokens': {\n",
    "            'PAD': 0,\n",
    "            'UNK': 1, \n",
    "            'CLS': 2,\n",
    "            'SEP': 3\n",
    "        }\n",
    "    }\n",
    "    \n",
    "    # Assign IDs to frequent tokens\n",
    "    start_id = max(vocab['special_tokens'].values()) + 1\n",
    "    for i, token in enumerate(frequent_tokens.index):\n",
    "        vocab['token_to_id'][token] = start_id + i\n",
    "        vocab['id_to_token'][start_id + i] = token\n",
    "    \n",
    "    print(f\"Vocabulary size: {len(vocab['token_to_id']):,} tokens\")\n",
    "    print(f\"Min frequency threshold: {min_freq}\")\n",
    "    print(f\"Total unique tokens before filtering: {len(token_counts):,}\")\n",
    "    \n",
    "    return vocab\n",
    "\n",
    "def discretize_numerical_values(aligned_events: pd.DataFrame, config: dict) -> pd.DataFrame:\n",
    "    \"\"\"Discretize numerical values using quantile bins.\"\"\"\n",
    "    \n",
    "    print(\"=== NUMERICAL VALUE DISCRETIZATION ===\")\n",
    "    \n",
    "    events_with_bins = aligned_events.copy()\n    \n",
    "    # Process numerical events (labs and vitals)\n",
    "    numerical_mask = events_with_bins['event_type'].isin(['lab', 'vital'])\n",
    "    numerical_events = events_with_bins[numerical_mask].copy()\n",
    "    \n",
    "    if len(numerical_events) \u003e 0:\n",
    "        # Convert value to numeric\n",
    "        numerical_events['numeric_value'] = pd.to_numeric(numerical_events['value'], errors='coerce')\n",
    "        \n",
    "        # Create quantile bins for each event code\n",
    "        value_bins = {}\n",
    "        n_bins = config['events']['value_bins']\n",
    "        \n",
    "        for event_code in numerical_events['event_code'].unique():\n",
    "            event_data = numerical_events[numerical_events['event_code'] == event_code]\n",
    "            valid_values = event_data['numeric_value'].dropna()\n",
    "            \n",
    "            if len(valid_values) \u003e= 10:  # Minimum samples for binning\n",
    "                bins = pd.qcut(valid_values, q=n_bins, duplicates='drop', retbins=True)[1]\n",
    "                value_bins[event_code] = bins\n",
    "                \n",
    "                # Assign bin labels\n",
    "                mask = numerical_events['event_code'] == event_code\n",
    "                numerical_events.loc[mask, 'value_bin'] = pd.cut(\n",
    "                    numerical_events.loc[mask, 'numeric_value'], \n",
    "                    bins=bins, \n",
    "                    labels=False,\n",
    "                    include_lowest=True\n",
    "                )\n",
    "        \n",
    "        # Update the main dataframe\n",
    "        events_with_bins.loc[numerical_mask, 'value_bin'] = numerical_events['value_bin']\n",
    "        events_with_bins.loc[numerical_mask, 'numeric_value'] = numerical_events['numeric_value']\n",
    "        \n",
    "        print(f\"Created value bins for {len(value_bins):,} event codes\")\n",
    "        print(f\"Numerical events with bins: {events_with_bins['value_bin'].notna().sum():,}\")\n",
    "    \n",
    "    return events_with_bins, value_bins\n",
    "\n",
    "# Create vocabulary and discretize values\n",
    "if len(aligned_events) \u003e 0:\n",
    "    vocab = create_event_vocabulary(aligned_events, HIBEHRT_CONFIG)\n",
    "    events_with_bins, value_bins = discretize_numerical_values(aligned_events, HIBEHRT_CONFIG)\n",
    "else:\n",
    "    print(\"⚠ Skipping vocabulary creation - no aligned events\")\n",
    "    vocab = {'token_to_id': {}, 'id_to_token': {}, 'special_tokens': {}}\n",
    "    events_with_bins = pd.DataFrame()\n",
    "    value_bins = {}"
   ]
  },
  {
   "cell_type": "markdown",
