   "source": [
    "def load_clinical_text(data_dir: Path, cohort_hadm_ids: set, config: dict) -> Dict[str, pd.DataFrame]:\n",
    "    \"\"\"Load clinical text data for cohort admissions.\"\"\"\n",
    "    \n",
    "    print(\"=== LOADING CLINICAL TEXT DATA ===\")\n",
    "    \n",
    "    text_data = {}\n",
    "    \n",
    "    # Load discharge notes\n",
    "    print(\"Loading discharge notes...\")\n",
    "    discharge_path = data_dir / 'note' / 'discharge.csv.gz'\n",
    "    if discharge_path.exists():\n",
    "        discharge_notes = pd.read_csv(\n",
    "            discharge_path,\n",
    "            parse_dates=['charttime', 'storetime'],\n",
    "            usecols=['subject_id', 'hadm_id', 'note_type', 'charttime', 'storetime', 'text']\n",
    "        )\n",
    "        discharge_notes = discharge_notes[discharge_notes['hadm_id'].isin(cohort_hadm_ids)]\n",
    "        discharge_notes['note_type'] = 'discharge'\n",
    "        text_data['discharge'] = discharge_notes\n",
    "        print(f\"  Loaded {len(discharge_notes):,} discharge notes for {discharge_notes['hadm_id'].nunique():,} admissions\")\n",
    "    \n",
    "    # Load radiology reports\n",
    "    print(\"Loading radiology reports...\")\n",
    "    radiology_path = data_dir / 'note' / 'radiology.csv.gz'\n",
    "    if radiology_path.exists():\n",
    "        radiology_reports = pd.read_csv(\n",
    "            radiology_path,\n",
    "            parse_dates=['charttime', 'storetime'],\n",
    "            usecols=['subject_id', 'hadm_id', 'note_type', 'charttime', 'storetime', 'text']\n",
    "        )\n",
    "        radiology_reports = radiology_reports[radiology_reports['hadm_id'].isin(cohort_hadm_ids)]\n",
",
    "        radiology_reports['note_type'] = 'radiology'\n",
    "        text_data['radiology'] = radiology_reports\n",
    "        print(f\"  Loaded {len(radiology_reports):,} radiology reports for {radiology_reports['hadm_id'].nunique():,} admissions\")\n",
    "    \n",
    "    return text_data\n",
    "\n",
    "# Get cohort HADM IDs\n",
    "if cohort_with_splits is not None:\n",
    "    cohort_hadm_ids = set(cohort_with_splits['hadm_id'])\n",
    "    print(f\"Processing text for {len(cohort_hadm_ids):,} cohort admissions\")\n",
    "    \n",
    "    # Load text data\n",
    "    text_data = load_clinical_text(DATA_DIR, cohort_hadm_ids, BERT_CONFIG)\n",
    "else:\n",
    "    print(\"⚠ No cohort data available. Will work with sample data.\")\n",
    "    text_data = {}"
   ]
  },
