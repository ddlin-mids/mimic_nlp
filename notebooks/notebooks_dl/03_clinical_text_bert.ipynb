   "source": [
    "## Text Preprocessing and Quality Control"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def preprocess_clinical_text(text_data: Dict[str, pd.DataFrame], config: dict) -> pd.DataFrame:\n",
    "    \"\"\"Preprocess clinical text for BERT encoding.\"\"\"\n",
    "    \n",
    "    print(\"=== CLINICAL TEXT PREPROCESSING ===\")\n",
    "    \n",
    "    all_notes = []\n",
    "    \n",
    "    for note_type, notes_df in text_data.items():\n",
    "        print(f\"Processing {note_type} notes...\")\n",
    "        \n",
    "        # Basic text cleaning\n",
    "        notes_df['text_clean'] = notes_df['text'].astype(str)\n",
    "        \n",
    "        # Remove very short notes\n",
    "        min_length = config['text_processing']['min_text_length']\n",
    "        notes_df = notes_df[notes_df['text_clean'].str.len() \u003e= min_length]\n",
    "        \n",
    "        # Remove very long notes (truncate if needed)\n",
    "        max_length = config['text_processing']['max_text_length']\n",
    "        notes_df['text_clean'] = notes_df['text_clean'].str[:max_length]\n",
    "        \n",
    "        # Add note length\n",
    "        notes_df['text_length'] = notes_df['text_clean'].str.len()\n",
    "        notes_df['word_count'] = notes_df['text_clean'].str.split().str.len()\n",
    "        \n",
    "        print(f\"  After filtering: {len(notes_df):,} notes\")\n",
    "        print(f\"  Average length: {notes_df['text_length'].mean():.0f} characters\")\n",
    "        print(f\"  Average words: {notes_df['word_count'].mean():.0f} words\")\n",
    "        \n",
    "        all_notes.append(notes_df)\n",
    "    \n",
    "    if all_notes:\n",
    "        combined_notes = pd.concat(all_notes, ignore_index=True)\n",
    "        print(f\"\\nTotal notes processed: {len(combined_notes):,}\")\n",
    "        return combined_notes\n",
    "    else:\n",
    "        print(\"⚠ No notes to process\")\n",
    "        return pd.DataFrame()\n",
    "\n",
    "# Preprocess text\n",
    "if text_data:\n",
    "    processed_notes = preprocess_clinical_text(text_data, BERT_CONFIG)\n",
    "else:\n",
    "    print(\"⚠ No text data available\")\n",
    "    processed_notes = pd.DataFrame()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Handle Multiple Notes per Admission"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def consolidate_notes_per_admission(notes_df: pd.DataFrame, cohort_df: pd.DataFrame, config: dict) -> pd.DataFrame:\n",
    "    \"\"\"Consolidate multiple notes per admission using the strategy from meeting notes.\"\"\"\n",
    "    \n",
    "    print(\"=== NOTE CONSOLIDATION ===\")\n",
    "    \n",
    "    # Merge with cohort to get admission times\n",
    "    notes_with_admit = notes_df.merge(\n",
    "        cohort_df[['hadm_id', 'admittime', 'dischtime']], \n",
    "        on='hadm_id', \n",
    "        how='inner'\n",
    "    )\n",
    "    \n",
    "    # Check for multiple notes per admission\n",
    "    notes_per_admission = notes_with_admit.groupby('hadm_id').size()\n",
    "    multi_note_admissions = notes_per_admission[notes_per_admission \u003e 1]\n",
    "    \n",
    "    print(f\"Admissions with multiple notes: {len(multi_note_admissions):,}\")\n",
    "    print(f\"Max notes per admission: {notes_per_admission.max()}\")\n",
    "    \n",
    "    consolidated_notes = []\n",
    "    \n",
    "    for hadm_id in notes_with_admit['hadm_id'].unique():\n",
    "        admission_notes = notes_with_admit[notes_with_admit['hadm_id'] == hadm_id].copy()\n",
    "        \n",
    "        if len(admission_notes) == 1:\n",
    "            # Single note - use as is\n",
    "            consolidated_notes.append(admission_notes.iloc[0].to_dict())\n",
    "        else:\n",
    "            # Multiple notes - apply consolidation strategy\n",
    "            \n",
    "            # Strategy 1: Prefer discharge notes over other types\n",
    "            discharge_notes = admission_notes[admission_notes['note_type'] == 'discharge']\n",
    "            \n",
    "            if len(discharge_notes) \u003e 0:\n",
    "                # Use the most recent discharge note\n",
    "                discharge_notes = discharge_notes.sort_values('charttime')\n",
    "                selected_note = discharge_notes.iloc[-1].to_dict()\n",
    "            else:\n",
    "                # Use the most recent note of any type\n",
    "                admission_notes = admission_notes.sort_values('charttime')\n",
    "                selected_note = admission_notes.iloc[-1].to_dict()\n",
    "            \n",
    "            # Strategy 2: Optionally concatenate (if configured)\n",
    "            if config['text_processing']['concatenate_notes']:\n",
    "                # Concatenate notes within time window\n",
",
    "                time_window = timedelta(hours=config['text_processing']['note_time_window_hours'])\n",
    "                base_time = selected_note['charttime']\n",
    "                \n",
    "                # Find notes within time window\n",
    "                nearby_notes = admission_notes[\n",
    "                    abs(admission_notes['charttime'] - base_time) \u003c= time_window\n",
    "                ]\n",
    "                \n",
    "                if len(nearby_notes) \u003e 1:\n",
    "                    # Concatenate with separators\n",
    "                    concatenated_text = \"\\n\\n[NOTE SEPARATOR]\\n\\n\".join(\n",
    "                        nearby_notes.sort_values('charttime')['text_clean'].tolist()\n",
    "                    )\n",
    "                    selected_note['text_clean'] = concatenated_text\n",
    "                    selected_note['note_type'] = 'consolidated'\n",
    "                    selected_note['text_length'] = len(concatenated_text)\n",
    "                    selected_note['word_count'] = len(concatenated_text.split())\n",
    "            \n",
    "            consolidated_notes.append(selected_note)\n",
    "    \n",
    "    consolidated_df = pd.DataFrame(consolidated_notes)\n",
    "    \n",
    "    print(f\"Final consolidated notes: {len(consolidated_df):,}\")\n",
    "    print(f\"Average length after consolidation: {consolidated_df['text_length'].mean():.0f} characters\")\n",
    "    \n",
    "    return consolidated_df\n",
    "\n",
    "# Consolidate notes\n",
    "if len(processed_notes) \u003e 0 and cohort_with_splits is not None:\n",
    "    consolidated_notes = consolidate_notes_per_admission(processed_notes, cohort_with_splits, BERT_CONFIG)\n",
    "else:\n",
    "    print(\"⚠ Skipping consolidation - no notes or cohort data\")\n",
    "    consolidated_notes = pd.DataFrame()"
   ]
  },
