   "source": [
    "## Text Tokenization and Length Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def analyze_text_lengths(notes_df: pd.DataFrame, tokenizer, config: dict) -> pd.DataFrame:\n",
    "    \"\"\"Analyze text lengths and token requirements.\"\"\"\n",
    "    \n",
    "    print(\"=== TEXT LENGTH ANALYSIS ===\")\n",
    "    \n",
    "    # Sample a subset for tokenization analysis (to avoid memory issues)\n",
    "    sample_size = min(1000, len(notes_df))\n",
    "    sample_df = notes_df.sample(n=sample_size, random_state=42)\n",
    "    \n",
    "    print(f\"Analyzing token lengths for {sample_size:,} sample notes...\")\n",
    "    \n",
    "    token_lengths = []\n",
    "    \n",
    "    for idx, row in sample_df.iterrows():\n",
    "        text = row['text_clean']\n",
    "        \n",
    "        # Tokenize\n",
    "        tokens = tokenizer.tokenize(text)\n",
    "        token_ids = tokenizer.encode(text, add_special_tokens=True)\n",
",
    "        \n",
    "        token_lengths.append({\n",
    "            'hadm_id': row['hadm_id'],\n",
    "            'note_type': row['note_type'],\n",
    "            'char_length': len(text),\n",
    "            'word_count': len(text.split()),\n",
    "            'token_count': len(tokens),\n",
    "            'token_ids_count': len(token_ids),\n",
    "            'exceeds_max_length': len(token_ids) \u003e config['model']['max_length']\n",
    "        })\n",
    "    \n",
    "    length_df = pd.DataFrame(token_lengths)\n",
    "    \n",
    "    print(f\"\\nToken length statistics:\")\n",
    "    print(f\"  Mean tokens per note: {length_df['token_count'].mean():.1f}\")\n",
    "    print(f\"  Median tokens per note: {length_df['token_count'].median():.1f}\")\n",
    "    print(f\"  Max tokens per note: {length_df['token_count'].max():,}\")\n",
    "    print(f\"  Notes exceeding max length ({config['model']['max_length']}): {length_df['exceeds_max_length'].sum():,} ({length_df['exceeds_max_length'].mean()*100:.1f}%)\")\n",
",
    "    \n",
    "    # By note type\n",
    "    if 'note_type' in length_df.columns:\n",
    "        print(f\"\\nToken counts by note type:\")\n",
    "        type_stats = length_df.groupby('note_type')['token_count'].agg(['count', 'mean', 'median', 'max']).round(1)\n",
    "        print(type_stats)\n",
    "    \n",
    "    return length_df\n",
    "\n",
    "# Analyze text lengths\n",
    "if len(consolidated_notes) \u003e 0:\n",
    "    length_analysis = analyze_text_lengths(consolidated_notes, tokenizer, BERT_CONFIG)\n",
    "else:\n",
    "    print(\"⚠ No notes to analyze\")\n",
    "    length_analysis = pd.DataFrame()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Sliding Window Strategy for Long Texts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_sliding_windows(text: str, tokenizer, max_length: int, stride: int) -> List[List[int]]:\n",
    "    \"\"\"Create sliding windows for long text processing.\"\"\"\n",
    "    \n",
    "    # Tokenize the full text\n",
    "    tokens = tokenizer.encode(text, add_special_tokens=False)\n",
    "    \n",
    "    if len(tokens) \u003c= max_length - 2:  # Account for [CLS] and [SEP]\n",
    "        # Text fits in single window\n",
    "        window = tokenizer.encode(text, add_special_tokens=True, max_length=max_length, padding='max_length', truncation=True)\n",
    "        return [window]\n",
    "    \n",
    "    # Create sliding windows\n",
    "    windows = []\n",
    "    start = 0\n",
    "    \n",
    "    while start \u003c len(tokens):\n",
    "        end = start + max_length - 2  # Account for special tokens\n",
    "        \n",
    "        # Extract window tokens\n",
    "        window_tokens = tokens[start:end]\n",
    "        \n",
    "        # Add special tokens\n",
    "        window = [tokenizer.cls_token_id] + window_tokens + [tokenizer.sep_token_id]\n",
    "        \n",
    "        # Pad to max_length\n",
    "        padding_length = max_length - len(window)\n",
    "        window = window + [tokenizer.pad_token_id] * padding_length\n",
    "        \n",
    "        windows.append(window)\n",
    "        \n",
    "        # Move to next window\n",
    "        start += stride\n",
    "        \n",
    "        if end \u003e= len(tokens):\n",
    "            break\n",
    "    \n",
    "    return windows\n",
    "\n",
    "def prepare_text_for_bert(notes_df: pd.DataFrame, tokenizer, config: dict) -> pd.DataFrame:\n",
    "    \"\"\"Prepare text data for BERT processing with sliding windows if needed.\"\"\"\n",
    "    \n",
    "    print(\"=== PREPARING TEXT FOR BERT ===\")\n",
    "    \n",
    "    max_length = config['model']['max_length']\n",
    "    stride = 128  # Default stride from meeting notes\n",
    "    \n",
    "    prepared_notes = []\n",
    "    \n",
    "    for idx, row in notes_df.iterrows():\n",
    "        text = row['text_clean']\n",
    "        \n",
    "        # Create sliding windows\n",
    "        windows = create_sliding_windows(text, tokenizer, max_length, stride)\n",
    "        \n",
    "        prepared_notes.append({\n",
    "            'subject_id': row['subject_id'],\n",
    "            'hadm_id': row['hadm_id'],\n",
    "            'note_type': row['note_type'],\n",
    "            'text': text,\n",
    "            'windows': windows,\n",
    "            'num_windows': len(windows),\n",
    "            'text_length': len(text),\n",
    "            'word_count': len(text.split())\n",
    "        })\n",
    "    \n",
    "    prepared_df = pd.DataFrame(prepared_notes)\n",
    "    \n",
    "    print(f\"Prepared {len(prepared_df):,} notes for BERT processing\")\n",
    "    print(f\"Notes requiring multiple windows: {(prepared_df['num_windows'] \u003e 1).sum():,}\")\n",
    "    print(f\"Average windows per note: {prepared_df['num_windows'].mean():.2f}\")\n",
    "    \n",
    "    return prepared_df\n",
    "\n",
    "# Prepare text for BERT\n",
    "if len(consolidated_notes) \u003e 0:\n",
    "    prepared_text = prepare_text_for_bert(consolidated_notes, tokenizer, BERT_CONFIG)\n",
    "else:\n",
    "    print(\"⚠ No notes to prepare\")\n",
    "    prepared_text = pd.DataFrame()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## BioClinical BERT Encoding"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def encode_text_with_bert(prepared_df: pd.DataFrame, tokenizer, model, device: torch.device, config: dict) -> pd.DataFrame:\n",
    "    \"\"\"Encode text using BioClinical BERT with attention pooling.\"\"\"\n",
",
    "    \n",
    "    print(\"=== BIOCLINICAL BERT ENCODING ===\")\n",
    "    \n",
    "    batch_size = config['model']['batch_size']\n",
    "    pooling_strategy = config['model']['pooling_strategy']\n",
    "    \n",
    "    encoded_notes = []\n",
    "    total_notes = len(prepared_df)\n",
    "    \n",
    "    print(f\"Encoding {total_notes:,} notes with BERT...\")\n",
    "    \n",
    "    with torch.no_grad():  # No gradient computation needed\n",
    "        for idx, row in prepared_df.iterrows():\n",
    "            if idx % 100 == 0:\n",
    "                print(f\"  Processed {idx:,} / {total_notes:,} ({idx/total_notes*100:.1f}%)\")\n",
    "            \n",
    "            windows = row['windows']\n",
    "            window_embeddings = []\n",
    "            \n",
    "            # Process each window\n",
    "            for window_idx, window_tokens in enumerate(windows):\n",
    "                # Convert to tensor\n",
    "                input_ids = torch.tensor([window_tokens]).to(device)\n",
    "                attention_mask = (input_ids != tokenizer.pad_token_id).long()\n",
    "                \n",
    "                # Get BERT embeddings\n",
    "                outputs = model(input_ids=input_ids, attention_mask=attention_mask)\n",
    "                \n",
    "                # Extract embeddings based on pooling strategy\n",
    "                if pooling_strategy == 'cls':\n",
    "                    # Use [CLS] token embedding\n",
    "                    window_embedding = outputs.last_hidden_state[:, 0, :]\n",
    "                elif pooling_strategy == 'mean':\n",
    "                    # Mean pooling over sequence length\n",
    "                    token_embeddings = outputs.last_hidden_state\n",
    "                    mask_expanded = attention_mask.unsqueeze(-1).expand(token_embeddings.size()).float()\n",
    "                    sum_embeddings = torch.sum(token_embeddings * mask_expanded, 1)\n",
    "                    sum_mask = torch.clamp(mask_expanded.sum(1), min=1e-9)\n",
    "                    window_embedding = sum_embeddings / sum_mask\n",
    "                elif pooling_strategy == 'attention':\n",
",
    "                    # Attention-based pooling (simplified)\n",
    "                    token_embeddings = outputs.last_hidden_state\n",
    "                    attention_weights = torch.softmax(\n",
    "                        outputs.last_hidden_state.mean(dim=-1), dim=-1\n",
    "                    ).unsqueeze(-1)\n",
    "                    window_embedding = torch.sum(token_embeddings * attention_weights, dim=1)\n",
    "                else:\n",
    "                    # Default to CLS token\n",
    "                    window_embedding = outputs.last_hidden_state[:, 0, :]\n",
    "                \n",
    "                window_embeddings.append(window_embedding.cpu().numpy())\n",
    "            \n",
    "            # Aggregate window embeddings (mean pooling)\n",
    "            if len(window_embeddings) \u003e 1:\n",
    "                final_embedding = np.mean(window_embeddings, axis=0)\n",
    "            else:\n",
    "                final_embedding = window_embeddings[0]\n",
    "            \n",
    "            encoded_notes.append({\n",
    "                'subject_id': row['subject_id'],\n",
    "                'hadm_id': row['hadm_id'],\n",
    "                'note_type': row['note_type'],\n",
    "                'embedding': final_embedding.squeeze(),\n",
    "                'embedding_dim': len(final_embedding.squeeze()),\n",
    "                'num_windows': row['num_windows'],\n",
    "                'text_length': row['text_length'],\n",
    "                'word_count': row['word_count']\n",
    "            })\n",
    "    \n",
    "    encoded_df = pd.DataFrame(encoded_notes)\n",
    "    \n",
    "    print(f\"Encoded {len(encoded_df):,} notes successfully\")\n",
    "    print(f\"Embedding dimension: {encoded_df['embedding_dim'].iloc[0]}\")\n",
    "    \n",
    "    return encoded_df\n",
    "\n",
    "# Encode text with BERT (this may take some time)\n",
    "if len(prepared_text) \u003e 0:\n",
    "    encoded_text = encode_text_with_bert(prepared_text, tokenizer, bert_model, device, BERT_CONFIG)\n",
    "else:\n",
    "    print(\"⚠ No text to encode\")\n",
    "    encoded_text = pd.DataFrame()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Create Admission-level Text Embeddings"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_admission_level_embeddings(encoded_df: pd.DataFrame, config: dict) -> pd.DataFrame:\n",
    "    \"\"\"Create admission-level embeddings by aggregating note embeddings.\"\"\"\n",
    "    \n",
    "    print(\"=== ADMISSION-LEVEL EMBEDDING AGGREGATION ===\")\n",
    "    \n",
    "    # Group by admission\n",
    "    admission_groups = encoded_df.groupby('hadm_id')\n",
    "    \n",
    "    admission_embeddings = []\n",
    "    \n",
    "    for hadm_id, group in admission_groups:\n",
    "        \n",
    "        # Get embeddings as numpy array\n",
    "        embeddings = np.array(group['embedding'].tolist())\n",
    "        \n",
    "        # Aggregate embeddings (mean pooling)\n",
",
    "        final_embedding = np.mean(embeddings, axis=0)\n",
    "        \n",
    "        # Get metadata\n",
    "        subject_id = group['subject_id'].iloc[0]\n",
    "        note_types = group['note_type'].unique().tolist()\n",
    "        num_notes = len(group)\n",
    "        avg_text_length = group['text_length'].mean()\n",
    "        total_word_count = group['word_count'].sum()\n",
    "        \n",
    "        admission_embeddings.append({\n",
    "            'subject_id': subject_id,\n",
    "            'hadm_id': hadm_id,\n",
    "            'text_embedding': final_embedding,\n",
    "            'embedding_dim': len(final_embedding),\n",
    "            'note_types': note_types,\n",
    "            'num_notes': num_notes,\n",
    "            'avg_text_length': avg_text_length,\n",
    "            'total_word_count': total_word_count,\n",
    "            'has_discharge_note': 'discharge' in note_types,\n",
    "            'has_radiology_note': 'radiology' in note_types\n",
    "        })\n",
    "    \n",
    "    admission_df = pd.DataFrame(admission_embeddings)\n",
    "    \n",
    "    print(f\"Created admission-level embeddings for {len(admission_df):,} admissions\")\n",
    "    print(f\"Average notes per admission: {admission_df['num_notes'].mean():.1f}\")\n",
    "    print(f\"Admissions with discharge notes: {admission_df['has_discharge_note'].sum():,}\")\n",
    "    print(f\"Admissions with radiology notes: {admission_df['has_radiology_note'].sum():,}\")\n",
    "    \n",
    "    return admission_df\n",
    "\n",
    "# Create admission-level embeddings\n",
    "if len(encoded_text) \u003e 0:\n",
    "    admission_embeddings = create_admission_level_embeddings(encoded_text, BERT_CONFIG)\n",
    "else:\n",
    "    print(\"⚠ No encoded text to aggregate\")\n",
    "    admission_embeddings = pd.DataFrame()"
   ]
  },
  {
   "cell_type": "markdown",
