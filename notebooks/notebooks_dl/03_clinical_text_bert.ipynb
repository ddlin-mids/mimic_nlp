    "def save_text_embeddings(final_df: pd.DataFrame, config: dict) -> None:\n",
    "    \"\"\"Save final text embeddings and processing metadata.\"\"\"\n",
    "    \n",
    "    print(\"=== SAVING TEXT EMBEDDINGS ===\")\n",
    "    \n",
    "    out_dir = OUTPUT_DIR\n",
    "    \n",
    "    # Save embeddings (convert numpy arrays to list for parquet compatibility)\n",
    "    embeddings_file = out_dir / config['output']['text_embeddings']\n",
    "    \n",
    "    if len(final_df) \u003e 0:\n",
    "        # Convert embeddings to list format\n",
    "        save_df = final_df.copy()\n",
    "        save_df['text_embedding'] = save_df['text_embedding'].apply(lambda x: x.tolist() if isinstance(x, np.ndarray) else x)\n",
    "        \n",
    "        # Select relevant columns\n",
    "        save_cols = ['subject_id', 'hadm_id', 'split', 'readmit_30d', 'text_embedding', \n",
    "                    'embedding_dim', 'note_types', 'num_notes', 'avg_text_length']\n",
    "        save_df = save_df[save_cols]\n",
    "        \n",
    "        save_df.to_parquet(embeddings_file)\n",
    "        print(f\"Saved text embeddings: {embeddings_file}\")\n",
    "        print(f\"  Shape: {save_df.shape}\")\n",
    "        print(f\"  Embedding dimension: {save_df['embedding_dim'].iloc[0]}\")\n",
    "    \n",
    "    # Save processing metadata\n",
    "    notes_file = out_dir / config['output']['notes_processed']\n",
    "    \n",
    "    if len(consolidated_notes) \u003e 0:\n",
    "        # Save notes metadata\n",
    "        notes_metadata = consolidated_notes[['hadm_id', 'note_type', 'text_length', 'word_count']].copy()\n",
    "        notes_metadata.to_parquet(notes_file)\n",
    "        print(f\"Saved notes metadata: {notes_file}\")\n",
    "    \n",
    "    # Save configuration and statistics\n",
    "    stats_file = out_dir / 'text_processing_stats.json'\n",
    "    \n",
    "    stats = {\n",
    "        'total_admissions': len(final_df),\n",
    "        'total_notes_processed': len(consolidated_notes),\n",
    "        'embedding_dimension': config['output']['embedding_dim'],\n",
    "        'model_used': config['model']['model_name'],\n",
    "        'pooling_strategy': config['model']['pooling_strategy'],\n",
    "        'max_length': config['model']['max_length'],\n",
    "        'notes_with_discharge': int(final_df['has_discharge_note'].sum()) if len(final_df) \u003e 0 else 0,\n",
    "        'notes_with_radiology': int(final_df['has_radiology_note'].sum()) if len(final_df) \u003e 0 else 0\n",
    "    }\n",
    "    \n",
    "    with open(stats_file, 'w') as f:\n",
    "        json.dump(stats, f, indent=2)\n",
    "    print(f\"Saved processing stats: {stats_file}\")\n",
    "\n",
    "# Save embeddings\n",
    "save_text_embeddings(final_embeddings, BERT_CONFIG)"
