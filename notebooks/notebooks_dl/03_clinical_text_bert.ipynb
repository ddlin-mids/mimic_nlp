   "source": [
    "## Merge with Labels and Splits"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def merge_with_labels_and_splits(embeddings_df: pd.DataFrame, cohort_with_splits: pd.DataFrame, labels_df: pd.DataFrame) -> pd.DataFrame:\n",
    "    \"\"\"Merge text embeddings with labels and train/val/test splits.\"\"\"\n",
    "    \n",
    "    print(\"=== MERGING WITH LABELS AND SPLITS ===\")\n",
    "    \n",
    "    # Merge embeddings with cohort data (includes splits)\n",
    "    merged_df = embeddings_df.merge(\n",
    "        cohort_with_splits[['hadm_id', 'subject_id', 'split', 'admittime', 'dischtime']], \n",
    "        on=['hadm_id', 'subject_id'], \n",
    "        how='inner'\n",
    "    )\n",
    "    \n",
    "    # Merge with labels\n",
    "    merged_df = merged_df.merge(\n",
    "        labels_df[['hadm_id', 'readmit_30d', 'days_to_readmit']], \n",
    "        on='hadm_id', \n",
    "        how='left'\n",
    "    )\n",
    "    \n",
    "    print(f\"Merged embeddings with labels: {len(merged_df):,} admissions\")\n",
    "    \n",
    "    # Check coverage\n",
    "    original_embeddings = len(embeddings_df)\n",
    "    final_merged = len(merged_df)\n",
    "    coverage_rate = final_merged / original_embeddings * 100 if original_embeddings \u003e 0 else 0\n",
    "    \n",
    "    print(f\"Coverage rate: {coverage_rate:.1f}%\")\n",
    "    \n",
    "    # Split distribution\n",
    "    if 'split' in merged_df.columns:\n",
    "        print(f\"\\nSplit distribution:\")\n",
    "        split_counts = merged_df['split'].value_counts()\n",
    "        for split, count in split_counts.items():\n",
    "            pct = count / len(merged_df) * 100\n",
    "            print(f\"  {split}: {count:,} ({pct:.1f}%)\")\n",
    "    \n",
    "    # Label distribution\n",
    "    if 'readmit_30d' in merged_df.columns:\n",
    "        print(f\"\\nLabel distribution:\")\n",
    "        label_counts = merged_df['readmit_30d'].value_counts()\n",
    "        for label, count in label_counts.items():\n",
    "            pct = count / len(merged_df) * 100\n",
    "            print(f\"  {label}: {count:,} ({pct:.1f}%)\")\n",
    "    \n",
    "    return merged_df\n",
    "\n",
    "# Load labels\n",
    "labels_file = OUTPUT_DIR / 'labels.parquet'\n",
    "if labels_file.exists():\n",
    "    labels_df = pd.read_parquet(labels_file)\n",
    "else:\n",
    "    labels_df = pd.DataFrame()\n",
    "\n",
    "# Merge with labels and splits\n",
    "if len(admission_embeddings) \u003e 0 and cohort_with_splits is not None and len(labels_df) \u003e 0:\n",
    "    final_embeddings = merge_with_labels_and_splits(admission_embeddings, cohort_with_splits, labels_df)\n",
    "else:\n",
    "    print(\"⚠ Missing required data for merging\")\n",
    "    final_embeddings = pd.DataFrame()"
   ]
