   "source": [
    "## Cohort Selection - Apply Exclusion Criteria"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def apply_cohort_filters(admissions: pd.DataFrame, config: dict) -> pd.DataFrame:\n",
    "    \"\"\"Apply cohort selection filters based on meeting notes criteria.\"\"\"\n",
    "    \n",
    "    print(\"=== COHORT SELECTION ===\")\n",
    "    print(f\"Starting admissions: {len(admissions):,}\")\n",
    "    \n",
    "    # Filter 1: Exclude in-hospital deaths\n",
    "    cohort = admissions[admissions['hospital_expire_flag'] == 0].copy()\n",
    "    print(f\"After excluding in-hospital deaths: {len(cohort):,}\")\n",
    "    \n",
    "    # Filter 2: Exclude specific admission types\n",
    "    admission_exclude = config['cohort']['admission_type_exclude']\n",
    "    if admission_exclude:\n",
    "        cohort = cohort[~cohort['admission_type'].isin(admission_exclude)]\n",
    "        print(f\"After excluding admission types {admission_exclude}: {len(cohort):,}\")\n",
    "    \n",
    "    # Filter 3: Exclude specific discharge locations\n",
    "    discharge_exclude = config['cohort']['discharge_exclude']\n",
    "    if discharge_exclude:\n",
    "        cohort = cohort[~cohort['discharge_location'].isin(discharge_exclude)]\n",
    "        print(f\"After excluding discharge locations {discharge_exclude}: {len(cohort):,}\")\n",
    "    \n",
    "    # Filter 4: Exclude short stays (< 48 hours)\n",
",
    "    cohort['los_hours'] = (cohort['dischtime'] - cohort['admittime']).dt.total_seconds() / 3600\n",
    "    min_los = config['cohort']['min_los_hours']\n",
    "    cohort = cohort[cohort['los_hours'] >= min_los]\n",
    "    print(f\"After excluding stays < {min_los} hours: {len(cohort):,}\")\n",
    "    \n",
    "    # Sort by patient and admission time for temporal consistency\n",
    "    cohort = cohort.sort_values(['subject_id', 'admittime']).reset_index(drop=True)\n",
    "    \n",
    "    print(f\"Final cohort: {len(cohort):,} admissions\")\n",
    "    return cohort\n",
    "\n",
    "# Apply cohort filters\n",
    "cohort = apply_cohort_filters(admissions, CONFIG)\n",
    "print(f\"\\nCohort retention rate: {len(cohort)/len(admissions)*100:.1f}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Label Generation - 30-Day Readmission"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def generate_readmission_labels(cohort: pd.DataFrame, config: dict) -> pd.DataFrame:\n",
    "    \"\"\"Generate 30-day readmission labels following meeting notes logic.\"\"\"\n",
    "    \n",
    "    print(\"=== LABEL GENERATION ===\")\n",
    "    \n",
    "    # Get all admissions (including those that died) for readmission checking\n",
    "    all_admissions = admissions[admissions['hospital_expire_flag'] == 0].copy()\n",
    "    all_admissions = all_admissions.sort_values(['subject_id', 'admittime']).reset_index(drop=True)\n",
    "    \n",
    "    # Initialize label columns\n",
    "    cohort['readmit_30d'] = 0\n",
    "    cohort['readmit_hadm_id'] = np.nan\n",
    "    cohort['days_to_readmit'] = np.nan\n",
",
    "    \n",
    "    # Group by patient for efficient lookup\n",
    "    patient_admissions = all_admissions.groupby('subject_id')\n",
    "    \n",
    "    readmit_count = 0\n",
    "    total = len(cohort)\n",
    "    \n",
    "    for idx, row in cohort.iterrows():\n",
    "        if (idx + 1) % 50000 == 0:\n",
    "            print(f\"  Processed {idx + 1:,} / {total:,} ({(idx+1)/total*100:.1f}%)\")\n",
    "        \n",
    "        subject_id = row['subject_id']\n",
    "        discharge_time = row['dischtime']\n",
    "        current_hadm_id = row['hadm_id']\n",
    "        \n",
    "        # Get all admissions for this patient\n",
    "        if subject_id not in patient_admissions.groups:\n",
    "            continue\n",
    "            \n",
    "        patient_admits = patient_admissions.get_group(subject_id)\n",
    "        \n",
    "        # Find future admissions (excluding current)\n",
    "        future_admits = patient_admits[\n",
    "            (patient_admits['admittime'] > discharge_time) &\n",
    "            (patient_admits['hadm_id'] != current_hadm_id)\n",
    "        ]\n",
    "        \n",
    "        if len(future_admits) > 0:\n",
    "            # Get the next admission\n",
    "            next_admit = future_admits.iloc[0]\n",
    "            days_to_next = (next_admit['admittime'] - discharge_time).total_seconds() / (24 * 3600)\n",
    "            \n",
    "            # Check if within 30-day window\n",
    "            readmit_window = config['cohort']['readmit_window_days']\n",
    "            if days_to_next <= readmit_window:\n",
    "                cohort.loc[idx, 'readmit_30d'] = 1\n",
    "                cohort.loc[idx, 'readmit_hadm_id'] = next_admit['hadm_id']\n",
    "                cohort.loc[idx, 'days_to_readmit'] = days_to_next\n",
    "                readmit_count += 1\n",
    "    \n",
    "    print(f\"\\nLabel generation complete:\")\n",
    "    print(f\"  Total admissions: {len(cohort):,}\")\n",
    "    print(f\"  Readmitted within 30 days: {readmit_count:,} ({readmit_count/len(cohort)*100:.2f}%)\")\n",
    "    print(f\"  Not readmitted: {len(cohort) - readmit_count:,} ({(len(cohort) - readmit_count)/len(cohort)*100:.2f}%)\")\n",
    "    \n",
    "    return cohort\n",
    "\n",
    "# Generate labels\n",
    "labeled_cohort = generate_readmission_labels(cohort, CONFIG)\n",
    "print(f\"\\nClass imbalance ratio: {(labeled_cohort['readmit_30d'] == 0).sum() / (labeled_cohort['readmit_30d'] == 1).sum():.2f}:1\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Patient-wise Train/Val/Test Split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_patient_wise_splits(labeled_cohort: pd.DataFrame, config: dict) -> pd.DataFrame:\n",
    "    \"\"\"Create patient-wise train/val/test splits to prevent data leakage.\"\"\"\n",
    "    \n",
    "    from sklearn.model_selection import train_test_split\n",
    "    \n",
    "    print(\"=== PATIENT-WISE SPLIT CREATION ===\")\n",
    "    \n",
    "    # Get unique patients and their readmission rates\n",
    "    patient_stats = labeled_cohort.groupby('subject_id').agg({\n",
    "        'readmit_30d': ['count', 'sum', 'mean']\n",
    "    }).round(3)\n",
    "    patient_stats.columns = ['num_admissions', 'num_readmits', 'readmit_rate']\n",
    "    \n",
    "    print(f\"Total unique patients: {len(patient_stats):,}\")\n",
    "    print(f\"Admissions per patient - Mean: {patient_stats['num_admissions'].mean():.2f}, \"\n",
    "          f\"Median: {patient_stats['num_admissions'].median():.0f}\")\n",
    "    \n",
    "    # Stratified split based on patient readmission rate\n",
    "    split_config = config['cohort']['split']\n",
    "    ratios = split_config['ratios']\n",
    "    seed = split_config['seed']\n",
    "    \n",
    "    # Create stratification groups\n",
    "    patient_stats['readmit_rate_bin'] = pd.cut(\n",
    "        patient_stats['readmit_rate'], \n",
    "        bins=[0, 0.2, 0.5, 1.0], \n",
    "        labels=['low', 'medium', 'high']\n",
    "    )\n",
    "    \n",
    "    # Split patients\n",
    "    patients = patient_stats.index.values\n",
    "    stratify_by = patient_stats['readmit_rate_bin'].values\n",
    "    \n",
    "    # First split: train + (val+test)\n",
    "    train_patients, val_test_patients = train_test_split(\n",
    "        patients, \n",
    "        test_size=ratios['val'] + ratios['test'],\n",
    "        stratify=stratify_by,\n",
    "        random_state=seed\n",
    "    )\n",
    "    \n",
    "    # Second split: val vs test\n",
    "    val_patients, test_patients = train_test_split(\n",
    "        val_test_patients,\n",
    "        test_size=ratios['test'] / (ratios['val'] + ratios['test']),\n",
    "        stratify=patient_stats.loc[val_test_patients, 'readmit_rate_bin'].values,\n",
    "        random_state=seed\n",
    "    )\n",
    "    \n",
    "    # Create split assignments\n",
    "    labeled_cohort['split'] = 'train'\n",
    "    labeled_cohort.loc[labeled_cohort['subject_id'].isin(val_patients), 'split'] = 'val'\n",
    "    labeled_cohort.loc[labeled_cohort['subject_id'].isin(test_patients), 'split'] = 'test'\n",
    "    \n",
    "    # Verify splits\n",
    "    print(f\"\\nSplit distribution:\")\n",
    "    split_counts = labeled_cohort['split'].value_counts()\n",
    "    for split, count in split_counts.items():\n",
    "        pct = count / len(labeled_cohort) * 100\n",
    "        print(f\"  {split}: {count:,} ({pct:.1f}%)\")\n",
    "    \n",
    "    # Check readmission rates by split\n",
    "    print(f\"\\nReadmission rates by split:\")\n",
    "    for split in ['train', 'val', 'test']:\n",
    "        split_data = labeled_cohort[labeled_cohort['split'] == split]\n",
    "        readmit_rate = split_data['readmit_30d'].mean()\n",
    "        print(f\"  {split}: {readmit_rate:.3f}\")\n",
    "    \n",
    "    return labeled_cohort\n",
    "\n",
    "# Create splits\n",
    "final_cohort = create_patient_wise_splits(labeled_cohort, CONFIG)"
   ]
  },
