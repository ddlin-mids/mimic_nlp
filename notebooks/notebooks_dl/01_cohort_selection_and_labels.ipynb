   "source": [
    "## Save Data Contracts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def save_data_contracts(final_cohort: pd.DataFrame, config: dict) -> None:\n",
    "    \"\"\"Save data according to meeting notes contracts.\"\"\"\n",
    "    \n",
    "    print(\"=== SAVING DATA CONTRACTS ===\")\n",
    "    \n",
    "    out_dir = Path(config['data']['out_dir'])\n",
    "    \n",
    "    # 1. Cohort table - one row per admission with filters applied\n",
    "    cohort_cols = ['subject_id', 'hadm_id', 'admittime', 'dischtime', 'admission_type', \n",
    "                   'admission_location', 'discharge_location', 'insurance', 'language', \n",
    "                   'marital_status', 'race', 'los_hours']\n",
    "    cohort_table = final_cohort[cohort_cols].copy()\n",
    "    cohort_file = out_dir / config['paths']['output_cohort']\n",
    "    cohort_table.to_parquet(cohort_file)\n",
    "    print(f\"Saved cohort table: {cohort_file}\")\n",
    "    print(f\"  Shape: {cohort_table.shape}\")\n",
    "    \n",
    "    # 2. Labels table - readmission outcomes\n",
    "    label_cols = ['hadm_id', 'readmit_30d', 'readmit_hadm_id', 'days_to_readmit']\n",
    "    labels_table = final_cohort[label_cols].copy()\n",
    "    labels_file = out_dir / config['paths']['output_labels']\n",
    "    labels_table.to_parquet(labels_file)\n",
    "    print(f\"Saved labels table: {labels_file}\")\n",
    "    print(f\"  Shape: {labels_table.shape}\")\n",
