    "def load_mimic_data(data_dir: Path, config: dict) -> Tuple[pd.DataFrame, pd.DataFrame]:\n",
    "    \"\"\"Load MIMIC-IV admissions and patients data.\"\"\"\n",
    "    \n",
    "    # Load admissions\n",
    "    admissions_path = data_dir / config['paths']['admissions_file']\n",
    "    print(f\"Loading admissions from: {admissions_path}\")\n",
    "    admissions = pd.read_csv(admissions_path)\n",
    "    \n",
    "    # Load patients\n",
    "    patients_path = data_dir / config['paths']['patients_file']\n",
    "    print(f\"Loading patients from: {patients_path}\")\n",
    "    patients = pd.read_csv(patients_path)\n",
    "    \n",
    "    # Convert datetime columns\n",
    "    datetime_cols = ['admittime', 'dischtime', 'deathtime', 'edregtime', 'edouttime']\n",
    "    for col in datetime_cols:\n",
    "        if col in admissions.columns:\n",
    "            admissions[col] = pd.to_datetime(admissions[col])\n",
    "    \n",
    "    print(f\"Loaded {len(admissions):,} admissions for {admissions['subject_id'].nunique():,} patients\")\n",
    "    return admissions, patients\n",
    "\n",
    "# Load data\n",
    "admissions, patients = load_mimic_data(DATA_DIR, CONFIG)\n",
    "print(f\"\\nAdmissions shape: {admissions.shape}\")\n",
    "print(f\"Patients shape: {patients.shape}\")"
   ]
