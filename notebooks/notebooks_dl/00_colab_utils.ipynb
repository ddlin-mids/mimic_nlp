   "metadata": {},
   "source": [
    "## MIMIC-IV Data Loading Utilities"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_mimic_table(data_path: Path, table_name: str, columns: Optional[List[str]] = None, \n",
    "                    parse_dates: Optional[List[str]] = None, sample_size: Optional[int] = None) -> pd.DataFrame:\n",
    "    \"\"\"Load a MIMIC-IV table with error handling and progress tracking.\"\"\"\n",
    "    \n",
    "    file_path = data_path / f\"{table_name}.csv.gz\"\n",
    "    \n",
    "    if not file_path.exists():\n",
    "        print(f\"⚠ File not found: {file_path}\")\n",
    "        return pd.DataFrame()\n",
    "    \n",
    "    print(f\"Loading {table_name}...\")\n",
    "    \n",
    "    try:\n",
    "        if sample_size:\n",
    "            # Load sample for initial exploration\n",
    "            df = pd.read_csv(file_path, nrows=sample_size, usecols=columns, parse_dates=parse_dates)\n",
    "            print(f\"  Loaded sample of {len(df):,} rows\")\n",
    "        else:\n",
    "            df = pd.read_csv(file_path, usecols=columns, parse_dates=parse_dates)\n",
    "            print(f\"  Loaded {len(df):,} rows\")\n",
    "        \n",
    "        return df\n",
    "    \n",
    "    except Exception as e:\n",
    "        print(f\"⚠ Error loading {table_name}: {e}\")\n",
    "        return pd.DataFrame()\n",
    "\n",
    "def get_mimic_file_info(data_path: Path) -> pd.DataFrame:\n",
    "    \"\"\"Get information about available MIMIC-IV files.\"\"\"\n",
    "    \n",
    "    files = []\n",
    "    \n",
    "    # Look for CSV.GZ files recursively\n",
    "    for csv_file in data_path.rglob(\"*.csv.gz\"):\n",
    "        size_mb = csv_file.stat().st_size / (1024 * 1024)\n",
    "        files.append({\n",
    "            'file_path': str(csv_file.relative_to(data_path)),\n",
    "            'file_name': csv_file.name,\n",
    "            'size_mb': round(size_mb, 1),\n",
    "            'directory': csv_file.parent.name\n",
    "        })\n",
    "    \n",
    "    files_df = pd.DataFrame(files)\n",
    "    \n",
    "    if len(files_df) \u003e 0:\n",
    "        files_df = files_df.sort_values(['directory', 'file_name'])\n",
    "        print(f\"Found {len(files_df):,} CSV.GZ files\")\n",
    "    \n",
    "    return files_df\n",
    "\n",
    "# Test the utilities\n",
    "print(\"Testing MIMIC data loading utilities...\")\n",
    "\n",
    "# Get file info (if data exists)\n",
    "if PATHS['physionet_data'].exists():\n",
    "    file_info = get_mimic_file_info(PATHS['physionet_data'])\n",
    "    if len(file_info) \u003e 0:\n",
    "        print(f\"\\nTop 10 largest files:\")\n",
    "        print(file_info.nlargest(10, 'size_mb')[['file_path', 'size_mb']])\n",
    "else:\n",
    "    print(\"⚠ Physionet data directory not found\")"
   ]
  },
