    "def setup_plotting_style():\n",
    "    \"\"\"Set up consistent plotting style for all notebooks.\"\"\"\n",
    "    \n",
    "    plt.style.use('seaborn-v0_8')\n",
    "    sns.set_palette(\"husl\")\n",
    "    \n",
    "    # Set default figure size\n",
    "    plt.rcParams['figure.figsize'] = (10, 6)\n",
    "    plt.rcParams['font.size'] = 12\n",
    "    \n",
    "    print(\"✓ Plotting style configured\")\n",
    "\n",
    "def plot_readmission_distribution(data: pd.DataFrame, save_path: Optional[Path] = None):\n",
    "    \"\"\"Plot readmission distribution with class balance info.\"\"\"\n",
    "    \n",
    "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 5))\n",
    "    \n",
    "    # Count plot\n",
    "    label_counts = data['readmit_30d'].value_counts()\n",
    "    label_counts.plot(kind='bar', ax=ax1, color=['skyblue', 'salmon'])\n",
    "    ax1.set_title('Readmission Distribution (Count)')\n",
    "    ax1.set_xlabel('Readmitted within 30 days')\n",
    "    ax1.set_ylabel('Count')\n",
    "    ax1.set_xticklabels(['No', 'Yes'], rotation=0)\n",
    "    \n",
    "    # Add count labels on bars\n",
    "    for i, v in enumerate(label_counts.values):\n",
    "        ax1.text(i, v + label_counts.max() * 0.01, f'{v:,}', ha='center', va='bottom')\n",
    "    \n",
    "    # Proportion plot\n",
",
    "    label_props = data['readmit_30d'].value_counts(normalize=True)\n",
    "    label_props.plot(kind='bar', ax=ax2, color=['skyblue', 'salmon'])\n",
    "    ax2.set_title('Readmission Distribution (Proportion)')\n",
    "    ax2.set_xlabel('Readmitted within 30 days')\n",
    "    ax2.set_ylabel('Proportion')\n",
    "    ax2.set_xticklabels(['No', 'Yes'], rotation=0)\n",
    "    \n",
    "    # Add percentage labels on bars\n",
    "    for i, v in enumerate(label_props.values):\n",
    "        ax2.text(i, v + 0.01, f'{v*100:.1f}%', ha='center', va='bottom')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    \n",
    "    if save_path:\n",
    "        plt.savefig(save_path, dpi=150, bbox_inches='tight')\n",
    "        print(f\"Plot saved to: {save_path}\")\n",
    "    \n",
    "    plt.show()\n",
    "\n",
    "def plot_temporal_analysis(data: pd.DataFrame, time_col: str, title: str = \"Temporal Distribution\", \n",
    "                          save_path: Optional[Path] = None):\n",
    "    \"\"\"Plot temporal distribution of events.\"\"\"\n",
    "    \n",
    "    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 8))\n",
    "    \n",
    "    # Histogram\n",
    "    data[time_col].hist(bins=50, ax=ax1, edgecolor='black')\n",
    "    ax1.set_title(f'{title} - Histogram')\n",
    "    ax1.set_xlabel(time_col)\n",
    "    ax1.set_ylabel('Frequency')\n",
    "    \n",
    "    # Box plot\n",
    "    data.boxplot(column=time_col, ax=ax2)\n",
    "    ax2.set_title(f'{title} - Box Plot')\n",
    "    ax2.set_ylabel(time_col)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    \n",
    "    if save_path:\n",
    "        plt.savefig(save_path, dpi=150, bbox_inches='tight')\n",
    "        print(f\"Plot saved to: {save_path}\")\n",
    "    \n",
    "    plt.show()\n",
    "\n",
    "# Setup plotting\n",
    "setup_plotting_style()"
   ]
