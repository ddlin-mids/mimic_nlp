    "    \n",
    "    return {\n",
    "        'cohort': {\n",
    "            'file': 'cohort.parquet',\n",
    "            'columns': ['subject_id', 'hadm_id', 'admittime', 'dischtime', 'admission_type', \n",
    "                       'discharge_location', 'age_at_admit', 'gender', 'race', 'split']\n",
    "        },\n",
    "        'labels': {\n",
    "            'file': 'labels.parquet',\n",
    "            'columns': ['hadm_id', 'readmit_30d', 'readmit_hadm_id', 'days_to_readmit']\n",
    "        },\n",
    "        'splits': {\n",
    "            'file': 'splits.parquet',\n",
    "            'columns': ['hadm_id', 'split']\n",
    "        },\n",
    "        'structured_events': {\n",
    "            'file': 'structured_events.parquet',\n",
    "            'columns': ['subject_id', 'hadm_id', 'token_ids', 'time_deltas', 'values']\n",
    "        },\n",
    "        'text_embeddings': {\n",
    "            'file': 'text_embeddings.parquet',\n",
    "            'columns': ['subject_id', 'hadm_id', 'text_embedding', 'embedding_dim']\n",
    "        }\n",
    "    }\n",
    "\n",
    "# Test imports\n",
    "print(\"Testing integration with src modules...\")\n",
    "src_modules = try_import_src_modules()\n",
    "\n",
    "# Show data contracts template\n",
    "contracts = create_data_contracts_template()\n",
    "print(f\"\\nData contracts template created with {len(contracts)} file types\")"
   ]
