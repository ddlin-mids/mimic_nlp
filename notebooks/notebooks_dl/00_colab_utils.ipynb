    "def setup_project_paths(project_name: str = \"MIMIC_NLP_Project\") -> Dict[str, Path]:\n",
    "    \"\"\"Set up project directory structure.\"\"\"\n",
    "    \n",
    "    # Base paths\n",
    "    project_root = Path(f'/content/drive/MyDrive/{project_name}')\n",
    "    \n",
    "    # Subdirectories\n",
    "    paths = {\n",
    "        'project_root': project_root,\n",
    "        'data': project_root / 'data',\n",
    "        'artifacts': project_root / 'artifacts',\n",
    "        'physionet_data': project_root / 'physionet_data',\n",
    "        'models': project_root / 'models',\n",
    "        'outputs': project_root / 'outputs',\n",
    "        'src': Path('/content/drive/MyDrive/mimic_nlp/src')  # Path to existing src\n",
    "    }\n",
    "    \n",
    "    # Create directories\n",
    "    for path in paths.values():\n",
    "        if isinstance(path, Path):\n",
    "            path.mkdir(exist_ok=True, parents=True)\n",
    "    \n",
    "    return paths\n",
    "\n",
    "# Setup paths\n",
    "PATHS = setup_project_paths()\n",
    "\n",
    "# Add src to Python path\n",
    "if PATHS['src'].exists():\n",
    "    sys.path.append(str(PATHS['src']))\n",
    "    print(f\"✓ Added src path: {PATHS['src']}\")\n",
    "else:\n",
    "    print(f\"⚠ Src path not found: {PATHS['src']}\")\n",
    "\n",
    "print(\"✓ Project paths configured:\")\n",
    "for name, path in PATHS.items():\n",
    "    print(f\"  {name}: {path}\")"
   ]
  },
